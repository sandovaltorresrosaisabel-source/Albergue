@{
    ViewData["Title"] = "Contacto";
}

<h1 class="mb-3">Contacto</h1>
<p class="texto-intro">¿Quieres adoptar, visitarnos o ayudar? Escríbenos.</p>

<div class="row g-4 mt-2">
    <div class="col-md-4">
        <div class="tarjeta-info">
            <i class="bi bi-geo-alt-fill"></i>
            <h4>Dirección</h4>
            <p>Escribe aquí la dirección del albergue</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="tarjeta-info">
            <i class="bi bi-telephone-fill"></i>
            <h4>Teléfono</h4>
            <p>Escribe aquí el teléfono o WhatsApp</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="tarjeta-info">
            <i class="bi bi-envelope-heart-fill"></i>
            <h4>Correo</h4>
            <p>Escribe aquí el correo</p>
        </div>
    </div>
</div>
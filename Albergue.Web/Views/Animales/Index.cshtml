@model List<Albergue.Web.Models.AnimalVm>
@{
    ViewData["Title"] = "Animales";
    var haySesion = Context.Session.GetString("nombre") != null;
}

@if (TempData["Ok"] != null)
{
    <div class="alert alert-success">@TempData["Ok"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Animales del albergue</h2>
    @if (haySesion)
    {
        <span>
            Hola, @Context.Session.GetString("nombre") (@Context.Session.GetString("rol"))
            <a class="btn btn-sm btn-outline-secondary ms-2" asp-controller="Solicitudes" asp-action="Mias">Mis solicitudes</a>
            <a class="btn btn-sm btn-outline-secondary ms-1" asp-controller="Account" asp-action="Logout">Salir</a>
        </span>
    }
    else
    {
        <a class="btn btn-primary" asp-controller="Account" asp-action="Login">Iniciar sesión</a>
    }
</div>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr><th>Nombre</th><th>Especie</th><th>Edad</th><th>Estado</th><th>Ingreso</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var a in Model)
            {
                <tr>
                    <td>@a.Nombre</td>
                    <td>@a.Especie</td>
                    <td>@a.Edad</td>
                    <td><span class="badge @(a.Estado == "Disponible" ? "bg-success" : "bg-secondary")">@a.Estado</span></td>
                    <td>@a.FechaIngreso</td>
                    <td class="text-end">
                        @if (a.Estado == "Disponible")
                        {
                            if (haySesion)
                            {
                                <form method="post" asp-controller="Solicitudes" asp-action="Crear" class="d-inline">
                                    <input type="hidden" name="animalId" value="@a.IdAnimal" />
                                    <button type="submit" class="btn btn-sm btn-primary">Quiero adoptar</button>
                                </form>
                            }
                            else
                            {
                                <a class="btn btn-sm btn-outline-secondary" asp-controller="Account" asp-action="Login">Inicia sesión para adoptar</a>
                            }
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>